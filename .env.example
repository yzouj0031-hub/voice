# ============================================================
#  语音助手配置（复制此文件为 .env 后填写）
#  cp .env.example .env
# ============================================================

# 端口
PORT=3000

# 接口类型：openai 或 anthropic
#   openai    —— 兼容所有 OpenAI 格式接口（OpenAI / DeepSeek / Kimi / 智谱 /
#                本地 Ollama、LM Studio / 各种国内中转，只要是 /v1/chat/completions）
#   anthropic —— Anthropic 官方 Claude 接口
PROVIDER=openai

# API 地址（不要带末尾斜杠）
#   OpenAI 官方:       https://api.openai.com/v1
#   DeepSeek:          https://api.deepseek.com/v1
#   Kimi(Moonshot):    https://api.moonshot.cn/v1
#   智谱:              https://open.bigmodel.cn/api/paas/v4
#   本地 Ollama:       http://localhost:11434/v1
#   Anthropic:         https://api.anthropic.com
BASE_URL=https://api.openai.com/v1

# 你的 API Key（保密，只存在服务器端，不会暴露给手机浏览器）
API_KEY=sk-你的密钥

# 模型名
#   OpenAI:     gpt-4o-mini
#   DeepSeek:   deepseek-chat
#   Kimi:       moonshot-v1-8k
#   Anthropic:  claude-haiku-4-5
MODEL=gpt-4o-mini

# 助手的人设 / 系统提示词
SYSTEM_PROMPT=你是一个友好、简洁的中文语音助手。回答要口语化、自然，适合朗读出来，不要用 Markdown 符号、列表或表格，尽量简短。
